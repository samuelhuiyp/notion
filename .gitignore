# Never commit real credentials. Copy *.example.yaml -> *.secret.yaml (ignored),
# or encrypt with SOPS/age and commit *.enc.yaml instead.
*.secret.yaml
*.secret.yml
secrets/*.yaml
!secrets/*.example.yaml
.env
*.kubeconfig
kubeconfig*
# Ansible vault for the ONTAP playbook
vault.yaml
# Root CA exported by scripts/publish-ct-local-ca.sh (public cert; distribute via your trust tooling, not Git)
ct-local-root-ca.crt
