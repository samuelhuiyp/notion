extends: default
rules:
  line-length: disable
  document-start: disable
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
  indentation:
    spaces: 2
    indent-sequences: consistent
  # column-aligned tables (inventory) are intentional
  commas:
    max-spaces-after: -1
  colons:
    max-spaces-after: -1
